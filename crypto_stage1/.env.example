# crypto_stage1 provider configuration.
# Empty keys = deterministic fallback mode.

# Stage 0 uses Gemini Embedding 2 when this is set.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-002
GEMINI_EMBEDDING_PROVIDER=gemini

# Stage 2: Gemini 3.5 Flash primary, Gemma 4 31B fallback (both via Gemini API).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemma-4-31b-it

# Final stage uses NVIDIA.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional overrides.
LLM_PROVIDER=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
DATABASE_URL=
